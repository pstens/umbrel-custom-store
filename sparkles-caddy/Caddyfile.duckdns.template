# Public HTTPS entry point. The certificate is issued by Let's Encrypt with
# the DNS-01 challenge, because umbrelOS already occupies the host ports 80
# and 443 and no HTTP or TLS-ALPN challenge could reach this container.
*.@@PARENT@@.duckdns.org {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}

	@@MATCHER@@ host @@CHILD@@.@@PARENT@@.duckdns.org
	handle @@MATCHER@@ {
		reverse_proxy @@UPSTREAM@@
	}
}
