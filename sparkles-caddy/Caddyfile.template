# Local HTTPS entry point for this device's own address. A ".local" name is
# not publicly-trustable, so Caddy signs it with its own local authority and
# clients have to trust the Caddy root CA, which is served at
# "/caddy-ca.crt" below.
@@LOCAL_HOSTS@@ {
	tls internal
	root * /data/caddy/pki/authorities/local
	handle /caddy-ca.crt {
		rewrite * /root.crt
		file_server
	}
	handle {
		reverse_proxy @@UPSTREAM@@
	}
}
