{
	admin off
	# Keeps the plain-HTTP site below serving umbrelOS's app gateway instead
	# of redirecting it to HTTPS.
	auto_https disable_redirects
}

# Plain-HTTP entry point for umbrelOS's app gateway.
http:// {
	reverse_proxy {$CADDY_UPSTREAM}
}

# LAN HTTPS: point the DuckDNS record at this device's LAN IP. The wildcard
# certificate comes from Let's Encrypt via DNS-01, so no open port is needed.
*.{$DUCKDNS_SUBDOMAIN}.duckdns.org {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}

	@aio host {$AIOSTREAMS_SUBDOMAIN}.{$DUCKDNS_SUBDOMAIN}.duckdns.org
	handle @aio {
		reverse_proxy {$CADDY_UPSTREAM}
	}
}
