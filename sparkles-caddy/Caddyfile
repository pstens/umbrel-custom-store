# Caddy configuration for the sparkles-caddy app.
#
# Caddy substitutes {$VAR} from its own environment when it loads this file,
# so the values set in the app's umbrelOS environment settings apply directly.
#
# CADDY_ADDRESS is the site address Caddy serves (for example "http://" to
# serve plain HTTP on port 80). Keep the port at 80, that is the port umbrelOS
# connects to. CADDY_UPSTREAM is the address requests are proxied to.
{
	admin off
}

{$CADDY_ADDRESS} {
	reverse_proxy {$CADDY_UPSTREAM}
}
