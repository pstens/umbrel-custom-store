#!/usr/bin/env bash
set -euo pipefail

# Renders the Caddyfile the Caddy container loads.
#
# The Caddyfile is written here instead of being shipped as a package file
# because umbrelOS only copies "docker-compose.yml", "*.template",
# "exports.sh", "torrc" and "hooks" on update, and because umbrelOS renders
# "*.template" files with envsubst, which would eat Caddy's own {$VAR}
# placeholders. The committed "Caddyfile.template" is therefore rendered with
# plain "@@" placeholders, which envsubst leaves alone.
#
# The hook never fails the app lifecycle. A missing or invalid setting leaves
# Caddy serving the plain-HTTP site for the umbrelOS app gateway and logs
# what the user has to fix.

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
TEMPLATE="${APP_DIR}/Caddyfile.template"

DUCKDNS_SUBDOMAIN="${DUCKDNS_SUBDOMAIN:-}"
AIOSTREAMS_SUBDOMAIN="${AIOSTREAMS_SUBDOMAIN:-}"
DUCKDNS_TOKEN="${DUCKDNS_TOKEN:-}"
CADDY_UPSTREAM="${CADDY_UPSTREAM:-http://sparkles-aiostreams_aiostreams_1:3000}"

mkdir -p "${APP_DIR}"

# The plain-HTTP site for the umbrelOS app gateway is always written, so the
# app stays reachable even when the DuckDNS settings are incomplete.
cat > "${APP_DIR}/Caddyfile" <<EOF
# Generated by the sparkles-caddy pre-start hook. Do not edit; your changes
# are overwritten on every start and app update.

{
	admin off
}

# Insecure entry point for umbrelOS's app gateway, which proxies plain HTTP
# to this container on port 80.
http:// {
	reverse_proxy ${CADDY_UPSTREAM}
}
EOF

if [[ -z "${DUCKDNS_SUBDOMAIN}" ]]; then
	echo "Caddy: DUCKDNS_SUBDOMAIN is not set. Set the DuckDNS parent subdomain (for example homednx) in the Caddy app settings." >&2
	exit 0
fi

if [[ -z "${AIOSTREAMS_SUBDOMAIN}" ]]; then
	echo "Caddy: AIOSTREAMS_SUBDOMAIN is not set. Set the child subdomain for AIOStreams (for example aio) in the Caddy app settings." >&2
	exit 0
fi

if [[ -z "${DUCKDNS_TOKEN}" ]]; then
	echo "Caddy: DUCKDNS_TOKEN is not set. Copy the API token from https://www.duckdns.org into the Caddy app settings. The HTTPS site stays disabled until it is set." >&2
	exit 0
fi

# DuckDNS names are single labels, and the child label must not contain a dot
# because it is placed in front of the parent subdomain.
if [[ ! "${DUCKDNS_SUBDOMAIN}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]]; then
	echo "Caddy: DUCKDNS_SUBDOMAIN '${DUCKDNS_SUBDOMAIN}' is not a valid DuckDNS subdomain." >&2
	exit 0
fi

if [[ ! "${AIOSTREAMS_SUBDOMAIN}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]]; then
	echo "Caddy: AIOSTREAMS_SUBDOMAIN '${AIOSTREAMS_SUBDOMAIN}' is not a valid DNS label." >&2
	exit 0
fi

if [[ ! -f "${TEMPLATE}" ]]; then
	echo "Caddy: ${TEMPLATE} is missing. Reinstall the Caddy app to restore it." >&2
	exit 0
fi

# The placeholders use "@@" so that umbrelOS's envsubst pass over the
# "*.template" files leaves them alone.
sed \
	-e "s|@@PARENT@@|${DUCKDNS_SUBDOMAIN}|g" \
	-e "s|@@CHILD@@|${AIOSTREAMS_SUBDOMAIN}|g" \
	-e "s|@@MATCHER@@|@${AIOSTREAMS_SUBDOMAIN}|g" \
	-e "s|@@UPSTREAM@@|${CADDY_UPSTREAM}|g" \
	"${TEMPLATE}" > "${APP_DIR}/Caddyfile.https"

{
	cat "${APP_DIR}/Caddyfile"
	printf '\n'
	cat "${APP_DIR}/Caddyfile.https"
} > "${APP_DIR}/Caddyfile.tmp"

mv "${APP_DIR}/Caddyfile.tmp" "${APP_DIR}/Caddyfile"
rm -f "${APP_DIR}/Caddyfile.https"

echo "Caddy: wrote ${APP_DIR}/Caddyfile for ${AIOSTREAMS_SUBDOMAIN}.${DUCKDNS_SUBDOMAIN}.duckdns.org"
