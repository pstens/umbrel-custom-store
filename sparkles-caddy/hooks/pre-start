#!/usr/bin/env bash
set -euo pipefail

# Renders the Caddyfile the Caddy container loads.
#
# The Caddyfile is written here instead of being shipped as a package file
# because umbrelOS only copies "docker-compose.yml", "*.template",
# "exports.sh", "torrc" and "hooks" on update, and because umbrelOS renders
# "*.template" files with envsubst, which would eat Caddy's own {$VAR}
# placeholders. The committed templates are therefore rendered with plain "@@"
# placeholders, which envsubst leaves alone.
#
# The hook never fails the app lifecycle. The plain-HTTP site for the umbrelOS
# app gateway is always written, so the app stays reachable even when the
# DuckDNS settings are incomplete, and the log says what the user has to fix.

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
TEMPLATE="${APP_DIR}/Caddyfile.template"
DUCKDNS_TEMPLATE="${APP_DIR}/Caddyfile.duckdns.template"

DUCKDNS_SUBDOMAIN="${DUCKDNS_SUBDOMAIN:-}"
AIOSTREAMS_SUBDOMAIN="${AIOSTREAMS_SUBDOMAIN:-}"
DUCKDNS_TOKEN="${DUCKDNS_TOKEN:-}"
CADDY_UPSTREAM="${CADDY_UPSTREAM:-http://sparkles-aiostreams_aiostreams_1:3000}"
DEVICE_DOMAIN_NAME="${DEVICE_DOMAIN_NAME:-}"
DEVICE_HOSTNAME="${DEVICE_HOSTNAME:-}"
CADDY_LOCAL_HOST="${CADDY_LOCAL_HOST:-${DEVICE_DOMAIN_NAME}}"

mkdir -p "${APP_DIR}"

if [[ ! -f "${TEMPLATE}" ]]; then
	echo "Caddy: ${TEMPLATE} is missing. Reinstall the Caddy app to restore it." >&2
	exit 0
fi

# The local site covers this device's own address. The device domain name
# (umbrel.local) and the bare device hostname are one site with two names.
LOCAL_HOSTS="${CADDY_LOCAL_HOST}"
if [[ -n "${DEVICE_HOSTNAME}" && "${DEVICE_HOSTNAME}" != "${LOCAL_HOSTS}" ]]; then
	LOCAL_HOSTS="${LOCAL_HOSTS}, ${DEVICE_HOSTNAME}"
fi

# Without a local hostname there is no local site to serve, so the template's
# local block is dropped instead of producing an empty site address.
LOCAL_SITE=""
if [[ -z "${LOCAL_HOSTS// /}" ]]; then
	echo "Caddy: no local hostname is known. Set CADDY_LOCAL_HOST in the Caddy app settings to serve this device over HTTPS." >&2
else
	# The placeholders use "@@" so that umbrelOS's envsubst pass over the
	# "*.template" files leaves them alone.
	LOCAL_SITE="$(sed \
		-e "s|@@LOCAL_HOSTS@@|${LOCAL_HOSTS}|g" \
		-e "s|@@UPSTREAM@@|${CADDY_UPSTREAM}|g" \
		"${TEMPLATE}")"
fi

# The public HTTPS site needs the DuckDNS settings. Without them Caddy serves
# the plain-HTTP and local HTTPS sites only, so the app stays reachable.
DUCKDNS_SITE=""
if [[ -z "${DUCKDNS_SUBDOMAIN}" ]]; then
	echo "Caddy: DUCKDNS_SUBDOMAIN is not set. Set the DuckDNS parent subdomain (for example homednx) in the Caddy app settings." >&2
elif [[ -z "${AIOSTREAMS_SUBDOMAIN}" ]]; then
	echo "Caddy: AIOSTREAMS_SUBDOMAIN is not set. Set the child subdomain for AIOStreams (for example aio) in the Caddy app settings." >&2
elif [[ -z "${DUCKDNS_TOKEN}" ]]; then
	echo "Caddy: DUCKDNS_TOKEN is not set. Copy the API token from https://www.duckdns.org into the Caddy app settings. The public HTTPS site stays disabled until it is set." >&2
elif [[ ! "${DUCKDNS_SUBDOMAIN}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]]; then
	echo "Caddy: DUCKDNS_SUBDOMAIN '${DUCKDNS_SUBDOMAIN}' is not a valid DuckDNS subdomain." >&2
elif [[ ! "${AIOSTREAMS_SUBDOMAIN}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]]; then
	echo "Caddy: AIOSTREAMS_SUBDOMAIN '${AIOSTREAMS_SUBDOMAIN}' is not a valid DNS label." >&2
elif [[ ! -f "${DUCKDNS_TEMPLATE}" ]]; then
	echo "Caddy: ${DUCKDNS_TEMPLATE} is missing. Reinstall the Caddy app to restore it." >&2
else
	DUCKDNS_SITE="$(sed \
		-e "s|@@PARENT@@|${DUCKDNS_SUBDOMAIN}|g" \
		-e "s|@@CHILD@@|${AIOSTREAMS_SUBDOMAIN}|g" \
		-e "s|@@MATCHER@@|@${AIOSTREAMS_SUBDOMAIN}|g" \
		-e "s|@@UPSTREAM@@|${CADDY_UPSTREAM}|g" \
		"${DUCKDNS_TEMPLATE}")"
fi

{
	printf '# Generated by the sparkles-caddy pre-start hook. Do not edit; your changes\n# are overwritten on every start and app update.\n\n'
	# "auto_https disable_redirects" keeps the plain-HTTP site on port 80
	# serving the app gateway. Without it, Caddy redirects every HTTP request
	# to HTTPS as soon as any HTTPS site exists, and umbrelOS's app proxy would
	# get a redirect instead of the app.
	printf '{\n\tadmin off\n\tskip_install_trust\n\tauto_https disable_redirects\n}\n\n'
	cat <<EOF
# Insecure entry point for umbrelOS's app gateway, which proxies plain HTTP
# to this container on port 80.
http:// {
	root * /data/caddy/pki/authorities/local
	handle /caddy-ca.crt {
		rewrite * /root.crt
		file_server
	}
	handle {
		reverse_proxy ${CADDY_UPSTREAM}
	}
}

EOF
	if [[ -n "${LOCAL_SITE}" ]]; then
		printf '%s\n\n' "${LOCAL_SITE}"
	fi
	if [[ -n "${DUCKDNS_SITE}" ]]; then
		printf '%s\n' "${DUCKDNS_SITE}"
	fi
} > "${APP_DIR}/Caddyfile.tmp"

mv "${APP_DIR}/Caddyfile.tmp" "${APP_DIR}/Caddyfile"

if [[ -n "${DUCKDNS_SITE}" && -n "${LOCAL_SITE}" ]]; then
	echo "Caddy: wrote ${APP_DIR}/Caddyfile for ${AIOSTREAMS_SUBDOMAIN}.${DUCKDNS_SUBDOMAIN}.duckdns.org and ${LOCAL_HOSTS}"
elif [[ -n "${DUCKDNS_SITE}" ]]; then
	echo "Caddy: wrote ${APP_DIR}/Caddyfile for ${AIOSTREAMS_SUBDOMAIN}.${DUCKDNS_SUBDOMAIN}.duckdns.org"
elif [[ -n "${LOCAL_SITE}" ]]; then
	echo "Caddy: wrote ${APP_DIR}/Caddyfile for ${LOCAL_HOSTS}"
else
	echo "Caddy: wrote ${APP_DIR}/Caddyfile for the umbrelOS app gateway"
fi
